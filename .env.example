# Any OpenAI-compatible endpoint works. These are only defaults:
# the Settings page in the app can override them (saved to workspace/settings.json).

# --- Google Gemini (free tier, recommended) — key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=

# --- Groq (free tier) — key from https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Ollama (offline, runs on your PC) — `ollama pull qwen2.5-coder:7b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_KEY=ollama

API_PORT=3000
